# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000

# Backend - secrets
GEMINI_API_KEY=
SMTP_PASSWORD=
DATABASE_URL=
INGEST_SECRET=
DIGEST_SECRET=

# Backend - non-secret config
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@domain.com
EMAIL_FROM="AI Intelligence" <your_email@domain.com>
EMAIL_TO=recipient@domain.com
POLL_INTERVAL_MINUTES=10
DIGEST_HOUR=7
DIGEST_MINUTE=0
DIGEST_TIMEZONE=Asia/Kolkata
DATABASE_PATH=./database/ai_intelligence.db
PORT=8000
CORS_ORIGIN=http://localhost:5178,http://localhost:3000,https://your-frontend-url.vercel.app
MAX_NEW_ITEMS_PER_SOURCE=10
ENABLE_INTERNAL_SCHEDULER=true

# Production note:
# - Keep GEMINI_API_KEY, SMTP_PASSWORD, DATABASE_URL, INGEST_SECRET, and DIGEST_SECRET server-side only.
# - Never expose them to the Vite frontend or GitHub source files.
